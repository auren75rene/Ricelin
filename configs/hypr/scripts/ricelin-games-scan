#!/usr/bin/env python3
"""Compatibility CLI: all discovery logic lives in ricelin-game-discovery."""
import argparse, subprocess, sys
from pathlib import Path

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path.home() / "Games")
    args = parser.parse_args()
    scanner = Path(__file__).with_name("ricelin-game-discovery")
    return subprocess.call([sys.executable, str(scanner), "--home", str(Path.home()),
        "--root", str(args.root), "--format", "legacy-index"])

if __name__ == "__main__": raise SystemExit(main())
