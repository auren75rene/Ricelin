#!/usr/bin/env python3
"""Read-only discovery of game folders and plausible launch targets for Ricelin.

The scanner never executes discovered files and never writes registry data.
It emits a JSON index for AppRegistry to reconcile with its own persistent
records. Ambiguous folders are deliberately returned without a selected target.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import stat
import time
from pathlib import Path

WINDOWS_SUFFIXES = {".exe"}
NATIVE_SUFFIXES = {".appimage", ".x86_64"}
SKIP_DIRS = {
    ".git", ".cache", "cache", "caches", "prefix", "prefixes", ".wine",
    "wineprefix", "drive_c", "windows", "commonredist", "redist",
    "redistributable", "redistributables", "prereq", "prereqs",
    "prerequisites", "__installer", "installer", "uninstallers",
    "steamlibrary", "steamapps", "compatibilitytools.d", "downloads",
}
BAD_STEMS = re.compile(
    r"(?:^|[-_. ])(?:unins(?:tall)?\d*|uninstall|setup|install|"
    r"vc[_ -]?redist|vcredist|dxsetup|directxsetup|crashreporter|"
    r"crashhandler|unitycrashhandler|repair|updater|update)(?:$|[-_. ])",
    re.IGNORECASE,
)


def slug(value: str) -> str:
    out = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return out or "game"


def normalized(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "", value.lower())


def candidate_info(path: Path, game_name: str, game_root: Path) -> dict | None:
    if path.is_symlink() or not path.is_file():
        return None

    suffix = path.suffix.lower()
    if suffix not in WINDOWS_SUFFIXES and suffix not in NATIVE_SUFFIXES:
        # Native standalone binaries commonly have no suffix. Ignore shared
        # objects, data blobs, and scripts so they're not mistaken for games.
        if suffix or not os.access(path, os.X_OK):
            return None
        if path.name.startswith("."):
            return None
        kind = "native"
    else:
        kind = "windows" if suffix in WINDOWS_SUFFIXES else "native"

    stem = path.stem
    if BAD_STEMS.search(stem):
        return None

    try:
        rel_parts = [part.lower() for part in path.relative_to(game_root).parts[:-1]]
    except ValueError:
        return None
    if any(part in SKIP_DIRS for part in rel_parts):
        return None

    score = 0
    game_key = normalized(game_name)
    stem_key = normalized(stem)
    if stem_key and stem_key == game_key:
        score += 12
    elif stem_key and game_key and (stem_key in game_key or game_key in stem_key):
        score += 8
    if any(part in {"game", "bin", "binaries", "win64", "win32", "linux"} for part in rel_parts):
        score += 1
    if "launcher" in stem.lower():
        score -= 2

    return {
        "path": str(path),
        "name": stem,
        "kind": kind,
        "score": score,
    }


def choose_target(candidates: list[dict]) -> str:
    if len(candidates) == 1:
        return candidates[0]["path"]
    if not candidates:
        return ""
    ranked = sorted(candidates, key=lambda item: (-item["score"], item["path"].lower()))
    # A strong, clear name match may be auto-selected. A close match stays a
    # setup choice so a helper/installer is never guessed just because it sorts first.
    if ranked[0]["score"] >= 8 and ranked[0]["score"] - ranked[1]["score"] >= 4:
        return ranked[0]["path"]
    return ""


def scan(root: Path) -> dict:
    root = root.expanduser()
    try:
        root = root.resolve(strict=True)
    except OSError:
        return {"root": str(root), "games": [], "scannedAt": int(time.time())}
    if not root.is_dir():
        return {"root": str(root), "games": [], "scannedAt": int(time.time())}

    games: list[dict] = []
    # A first-level directory is one game identity. Existing game files remain
    # in place; the scan is metadata-only.
    try:
        children = sorted(root.iterdir(), key=lambda path: path.name.lower())
    except OSError:
        children = []

    for folder in children:
        if folder.name.startswith(".") or folder.is_symlink() or folder.name.lower() in SKIP_DIRS:
            continue
        if folder.is_dir():
            candidates: list[dict] = []
            for current, dirs, files in os.walk(folder, followlinks=False):
                current_path = Path(current)
                dirs[:] = [
                    name for name in dirs
                    if not name.startswith(".")
                    and name.lower() not in SKIP_DIRS
                    and not (current_path / name).is_symlink()
                ]
                for filename in files:
                    found = candidate_info(current_path / filename, folder.name, folder)
                    if found:
                        candidates.append(found)
            candidates.sort(key=lambda item: (-item["score"], item["path"].lower()))
            selected = choose_target(candidates)
            games.append({
                "sourcePath": str(folder.resolve()),
                "gameFolder": str(folder.resolve()),
                "name": folder.name,
                "executable": selected,
                "workingDirectory": str(Path(selected).parent) if selected else str(folder.resolve()),
                "candidateExecutables": candidates[:24],
                "needsSetup": not bool(selected),
            })
        elif folder.is_file():
            candidate = candidate_info(folder, folder.stem, root)
            if candidate:
                games.append({
                    "sourcePath": str(folder.resolve()),
                    "gameFolder": str(root),
                    "name": folder.stem,
                    "executable": str(folder.resolve()),
                    "workingDirectory": str(root),
                    "candidateExecutables": [candidate],
                    "needsSetup": False,
                })

    return {"root": str(root), "games": games, "scannedAt": int(time.time())}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", default=os.environ.get("RICELIN_GAMES_DIR") or str(Path.home() / "Games"))
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()
    result = scan(Path(args.root))
    print(json.dumps(result, indent=2 if args.pretty else None, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
